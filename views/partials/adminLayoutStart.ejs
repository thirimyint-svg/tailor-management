<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= pageTitle || "Milano Tailor Management" %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-gray-100">

<!-- Mobile header -->
<header class="lg:hidden bg-gray-900 text-white flex items-center justify-between px-4 py-3">
  <div class="font-semibold">Milano Tailor Admin</div>
  <button id="menuBtn" class="px-3 py-2 bg-gray-800 rounded">☰</button>
</header>

<div class="flex min-h-screen">

  <!-- Sidebar -->
  <aside id="sidebar"
    class="fixed lg:static inset-y-0 left-0 w-64 bg-gray-900 text-white transform -translate-x-full lg:translate-x-0 transition duration-200 z-40">

    <div class="px-4 py-4 border-b border-gray-800">
      <div class="text-lg font-bold">🧵 Milano Tailor Admin</div>
      <div class="text-xs text-gray-400">Management System</div>
    </div>

    <%
      var current = (typeof currentUrl !== "undefined" && currentUrl) ? currentUrl : "";

      var isActive = function (path) {
        return current.indexOf(path) === 0;
      };

      var linkCls = function (path) {
        return "group flex items-center px-4 py-2 rounded hover:bg-gray-800 " + (isActive(path) ? "bg-gray-800" : "");
      };

      var subLinkCls = function (path) {
        return "group flex items-center px-4 py-2 rounded hover:bg-gray-800 pl-10 text-sm " + (isActive(path) ? "bg-gray-800" : "");
      };

      var openInventory = isActive("/inventory");
      var openOrders = isActive("/orders") || isActive("/vouchers");
      var openAppointments = isActive("/appointments");
      var openReports = isActive("/reports");
    %>

    <nav class="mt-3 px-2 space-y-1">

      <!-- Dashboard -->
      <a href="/dashboard" class="<%= linkCls('/dashboard') %>">
        <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M3 12l9-9 9 9v9a2 2 0 01-2 2h-4a2 2 0 01-2-2V12H9v7a2 2 0 01-2 2H3z"/>
        </svg>
        📊 Dashboard
      </a>

      <!-- Customers -->
      <a href="/customers" class="<%= linkCls('/customers') %>">
        <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M17 20h5v-2a4 4 0 00-5-4M9 20H4v-2a4 4 0 015-4m4-4a4 4 0 11-8 0 4 4 0 018 0z"/>
        </svg>
        👤 Customers
      </a>

      <!-- Inventory Management -->
      <button type="button"
        class="w-full flex items-center justify-between px-4 py-2 rounded hover:bg-gray-800 <%= openInventory ? 'bg-gray-800' : '' %>"
        onclick="toggleMenu('invMenu')">

        <div class="flex items-center">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M20 13V7a2 2 0 00-2-2H6a2 2 0 00-2 2v6m16 0l-8 5-8-5"/>
          </svg>
          <span>📦</span>Stock Management
        </div>

        <span class="text-xs opacity-80">▾</span>
      </button>

      <div id="invMenu" class="<%= openInventory ? '' : 'hidden' %> space-y-1">
        <a href="/inventory/fabrics" class="<%= subLinkCls('/inventory/fabrics') %>">
          <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M4 4h16v16H4z"/>
          </svg>
          Fabric
        </a>

        <a href="/inventory/accessories" class="<%= subLinkCls('/inventory/accessories') %>">
          <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 3l4 7H8l4-7zM6 21h12"/>
          </svg>
          Accessories
        </a>

        <a href="/inventory/design-categories" class="<%= subLinkCls('/inventory/design-categories') %>">
          <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 2l4 4-8 8-4 0 0-4 8-8zM14 4l6 6"/>
          </svg>
          Design Category
        </a>
      </div>

      <!-- Order Management -->
      <button type="button"
        class="w-full flex items-center justify-between px-4 py-2 rounded hover:bg-gray-800 <%= openOrders ? 'bg-gray-800' : '' %>"
        onclick="toggleMenu('orderMenu')">

        <div class="flex items-center">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M5 8h14l-1.5 12h-11L5 8zM9 8V6a3 3 0 016 0v2"/>
          </svg>
          <span>🧾</span>Order Management
        </div>

        <span class="text-xs opacity-80">▾</span>
      </button>

      <div id="orderMenu" class="<%= openOrders ? '' : 'hidden' %> space-y-1">
        <a href="/orders" class="<%= subLinkCls('/orders') %>">
          <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9 12h6m-6 4h6M7 6h10a2 2 0 012 2v12H5V8a2 2 0 012-2z"/>
          </svg>
          Customer Order
        </a>

        <a href="/vouchers" class="<%= subLinkCls('/vouchers') %>">
          <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M4 7h16v4a2 2 0 010 4v4H4v-4a2 2 0 010-4V7z"/>
          </svg>
          Voucher
        </a>
      </div>

      <!-- Appointment -->
      <button type="button"
        class="w-full flex items-center justify-between px-4 py-2 rounded hover:bg-gray-800 <%= openAppointments ? 'bg-gray-800' : '' %>"
        onclick="toggleMenu('apptMenu')">

        <div class="flex items-center">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M8 7V3m8 4V3M3 11h18M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <span>📅</span>Appointment
        </div>

        <span class="text-xs opacity-80">▾</span>
      </button>

      <div id="apptMenu" class="<%= openAppointments ? '' : 'hidden' %> space-y-1">
        <a href="/appointments" class="<%= subLinkCls('/appointments') %>">
          <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9 5h6M7 9h10M7 13h10M7 17h10"/>
          </svg>
          Appointment List
        </a>

        <a href="/appointments/calendar/view" class="<%= subLinkCls('/appointments/calendar') %>">
          <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M8 7V3m8 4V3M3 11h18"/>
          </svg>
          Calendar
        </a>
      </div>

      <!-- Report -->
      <button type="button"
        class="w-full flex items-center justify-between px-4 py-2 rounded hover:bg-gray-800 <%= openReports ? 'bg-gray-800' : '' %>"
        onclick="toggleMenu('reportMenu')">

        <div class="flex items-center">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M11 3v18m4-10v10m4-6v6M7 13v8M3 17v4"/>
          </svg>
          <span>💰</span>Report
        </div>

        <span class="text-xs opacity-80">▾</span>
      </button>

      <div id="reportMenu" class="<%= openReports ? '' : 'hidden' %> space-y-1">
        <a href="/reports/sales" class="<%= subLinkCls('/reports/sales') %>">
          <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 17l6-6 4 4 8-8"/>
          </svg>
          Sale Report
        </a>

        <a href="/reports/stock" class="<%= subLinkCls('/reports/stock') %>">
          <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M4 4h16v16H4z"/>
          </svg>
          Stock Report
        </a>
      </div>

    </nav>
  </aside>

  <!-- Overlay -->
  <div id="overlay" class="fixed inset-0 bg-black/50 hidden lg:hidden z-30"></div>

  <!-- Main content -->
  <main class="flex-1 p-4 lg:p-6">

    <% if (success && success.length) { %>
      <div class="mb-4 p-3 bg-green-100 text-green-800 rounded"><%= success[0] %></div>
    <% } %>

    <% if (error && error.length) { %>
      <div class="mb-4 p-3 bg-red-100 text-red-800 rounded"><%= error[0] %></div>
    <% } %>

    <h1 class="text-2xl font-bold mb-1"><%= pageTitle || "" %></h1>
    <p class="text-sm text-gray-500 mb-6"><%= pageSubTitle || "" %></p>
