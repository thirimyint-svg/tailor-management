<%- include("../partials/adminLayoutStart", { pageTitle, pageSubTitle }) %>

<div class="max-w-2xl bg-white rounded-lg shadow p-6">
  <h2 class="text-lg font-bold mb-4">Edit Customer</h2>

  <form method="POST" action="/customers/<%= customer.id %>/update" class="space-y-4">
    <div>
      <label class="block text-sm font-medium mb-1">Name *</label>
      <input name="name" value="<%= customer.name %>"
             class="w-full border rounded px-3 py-2 focus:ring-2 focus:ring-gray-900 focus:outline-none" required />
    </div>

    <div>
      <label class="block text-sm font-medium mb-1">Phone *</label>
      <input name="phone" value="<%= customer.phone %>"
             class="w-full border rounded px-3 py-2 focus:ring-2 focus:ring-gray-900 focus:outline-none" required />
    </div>

    <div>
      <label class="block text-sm font-medium mb-1">Email</label>
      <input name="email" type="email" value="<%= customer.email || '' %>"
             class="w-full border rounded px-3 py-2 focus:ring-2 focus:ring-gray-900 focus:outline-none" />
    </div>

    <div>
      <label class="block text-sm font-medium mb-1">Address</label>
      <input name="address" value="<%= customer.address || '' %>"
             class="w-full border rounded px-3 py-2 focus:ring-2 focus:ring-gray-900 focus:outline-none" />
    </div>

    <div class="flex gap-3">
      <button class="bg-gray-900 text-white px-4 py-2 rounded hover:bg-gray-800">
        Update
      </button>
      <a href="/customers" class="bg-gray-100 px-4 py-2 rounded hover:bg-gray-200">
        Cancel
      </a>
    </div>
  </form>
</div>

<%- include("../partials/adminLayoutEnd") %>
