<%- include("../partials/adminLayoutStart", { pageTitle, pageSubTitle }) %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

  <!-- Form -->
  <%- include("create") %>

  <!-- List -->
  <div class="lg:col-span-2 bg-white rounded-lg shadow overflow-hidden">
    <div class="p-6 border-b">
      <h2 class="text-lg font-bold">Appointments List</h2>
      <p class="text-sm text-gray-500">Recent appointments</p>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead class="bg-gray-900 text-white">
          <tr>
            <th class="text-left px-4 py-3 text-sm">Customer</th>
            <th class="text-left px-4 py-3 text-sm">Date</th>
            <th class="text-left px-4 py-3 text-sm">Pickup</th>
            <th class="text-left px-4 py-3 text-sm">WhatsApp</th>
            <th class="text-left px-4 py-3 text-sm">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (appointments.length === 0) { %>
            <tr>
              <td class="px-4 py-4 text-sm text-gray-500" colspan="5">No appointments yet.</td>
            </tr>
          <% } %>

          <% appointments.forEach(a => { %>
            <tr class="border-t hover:bg-gray-50">
              <td class="px-4 py-3 text-sm font-medium"><%= a.Customer ? a.Customer.name : "-" %></td>
              <td class="px-4 py-3 text-sm"><%= new Date(a.appointmentAt).toLocaleString() %></td>
              <td class="px-4 py-3 text-sm"><%= a.hotelPickup ? "Yes" : "No" %></td>
              <td class="px-4 py-3 text-sm"><%= a.whatsapp || "-" %></td>
              <td class="px-4 py-3 text-sm">
                <form method="POST" action="/appointments/<%= a.id %>/delete"
                      onsubmit="return confirm('Delete this appointment?');">
                  <button class="bg-red-600 text-white px-3 py-1.5 rounded hover:bg-red-700">
                    Delete
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  function toggleHotel(show) {
    const box = document.getElementById("hotelBox");
    if (show) box.classList.remove("hidden");
    else box.classList.add("hidden");
  }
</script>
<script>
  const customers = <%- JSON.stringify(customers) %>;

  const nameInput = document.getElementById("customerName");
  const emailInput = document.getElementById("email");
  const whatsappInput = document.getElementById("whatsapp");

  function autofillCustomer() {
    const typed = (nameInput.value || "").trim().toLowerCase();
    const found = customers.find(c => (c.name || "").toLowerCase() === typed);

    if (found) {
      if (!emailInput.value) emailInput.value = found.email || "";
      if (!whatsappInput.value) whatsappInput.value = found.phone || ""; // using phone as whatsapp
    }
  }

  nameInput.addEventListener("change", autofillCustomer);
  nameInput.addEventListener("blur", autofillCustomer);
</script>

<%- include("../partials/adminLayoutEnd") %>
