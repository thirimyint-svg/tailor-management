<%- include("../partials/adminLayoutStart", { pageTitle, pageSubTitle }) %>

<% if (error && error.length) { %>
  <div class="mb-4 p-3 rounded bg-red-100 text-red-800 border border-red-200">
    <%= error[0] %>
  </div>
<% } %>

<% if (success && success.length) { %>
  <div class="mb-4 p-3 rounded bg-green-100 text-green-800 border border-green-200">
    <%= success[0] %>
  </div>
<% } %>

<div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40 backdrop-blur-xl">
  <div class="bg-white rounded-xl shadow p-6 max-w-3xl">
    <form action="/admin/login" method="POST" class="space-y-5">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">
          Email
        </label>
        <input
          type="email"
          name="email"
          required
          class="w-full border border-gray-300 rounded-lg px-3 py-2
                focus:outline-none focus:ring-2 focus:ring-gray-900"
          placeholder="you@email.com"
        />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">
          Password
        </label>
        <input
          type="password"
          name="password"
          required
          class="w-full border border-gray-300 rounded-lg px-3 py-2
                focus:outline-none focus:ring-2 focus:ring-gray-900"
          placeholder="••••••••"
        />
      </div>

      <button
        type="submit"
        class="w-full bg-gray-900 text-white py-2 rounded-lg
              hover:bg-gray-800 transition font-medium"
      >
        Login
      </button>

      <p class="mt-2 text-xs text-gray-500">
        Admin accounts are created by other Admin users.
      </p>
    </form>
  </div>
</div>

<%- include("../partials/adminLayoutEnd") %>