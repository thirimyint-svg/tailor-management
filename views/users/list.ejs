<%- include("../partials/adminLayoutStart", {
  pageTitle,
  pageSubTitle
}) %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Add User -->
  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-lg font-bold mb-4">Add <%= entityType === "admin" ? "Admin" : "Customer" %></h2>

    <form method="POST" action="/<%= entityType === "admin" ? "admins" : "customers" %>/create" class="space-y-4">
      <div>
        <label class="block text-sm font-medium mb-1">Name *</label>
        <input name="name" class="w-full border rounded px-3 py-2 focus:ring-2 focus:ring-gray-900 focus:outline-none" required />
      </div>

      <div>
        <label class="block text-sm font-medium mb-1">Phone *</label>
        <input name="phone" class="w-full border rounded px-3 py-2 focus:ring-2 focus:ring-gray-900 focus:outline-none" required />
      </div>

      <div>
        <label class="block text-sm font-medium mb-1">Email</label>
        <input name="email" type="email" class="w-full border rounded px-3 py-2 focus:ring-2 focus:ring-gray-900 focus:outline-none" />
      </div>

      <div>
        <label class="block text-sm font-medium mb-1">Address</label>
        <input name="address" class="w-full border rounded px-3 py-2 focus:ring-2 focus:ring-gray-900 focus:outline-none" />
      </div>

      <button class="bg-gray-900 text-white px-4 py-2 rounded hover:bg-gray-800">
        Save <%= entityType === "admin" ? "Admin" : "Customer" %>
      </button>
    </form>
  </div>

  <!-- User List -->
  <div class="lg:col-span-2 bg-white rounded-lg shadow overflow-hidden">
    <div class="p-6 border-b">
      <h2 class="text-lg font-bold"><%= entityType === "admin" ? "Admin" : "Customer" %> List</h2>
      <p class="text-sm text-gray-500 mt-1">Total: <%= users.length %></p>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead class="bg-gray-900 text-white">
          <tr>
            <th class="text-left px-4 py-3 text-sm">Name</th>
            <th class="text-left px-4 py-3 text-sm">Phone</th>
            <th class="text-left px-4 py-3 text-sm">Email</th>
            <th class="text-left px-4 py-3 text-sm">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (users.length === 0) { %>
            <tr>
              <td class="px-4 py-4 text-sm text-gray-500" colspan="4">No <%= entityType === "admin" ? "admins" : "customers" %> yet.</td>
            </tr>
          <% } %>

          <% users.forEach(c => { %>
            <tr class="border-t hover:bg-gray-50">
              <td class="px-4 py-3 text-sm font-medium"><%= c.name %></td>
              <td class="px-4 py-3 text-sm"><%= c.phone %></td>
              <td class="px-4 py-3 text-sm"><%= c.email || "-" %></td>
              <td class="px-4 py-3 text-sm">
                <div class="flex gap-2">
                  <a href="/<%= entityType === "admin" ? "admins" : "customers" %>/<%= c.id %>/edit"
                     class="bg-gray-900 text-white px-3 py-1.5 rounded hover:bg-gray-800">
                    Edit
                  </a>

                  <form method="POST" action="/<%= entityType === "admin" ? "admins" : "customers" %>/<%= c.id %>/delete"
                        onsubmit="return confirm('Delete this <%= entityType === "admin" ? "admin" : "customer" %>?');">
                    <button class="bg-red-600 text-white px-3 py-1.5 rounded hover:bg-red-700">
                      Delete
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include("../partials/adminLayoutEnd") %>
