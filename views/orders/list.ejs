<%- include("../partials/adminLayoutStart", { pageTitle: "Orders", pageSubTitle: "View and manage all customer orders" }) %>

<div class="bg-white rounded-lg shadow p-6">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h2 class="text-xl font-semibold">Orders</h2>
      <p class="text-gray-500 text-sm">All customer orders</p>
    </div>

    <a href="/orders/create"
       class="px-4 py-2 rounded bg-gray-900 text-white text-sm font-medium hover:bg-gray-800">
      + Create Order
    </a>
  </div>

  <div class="overflow-x-auto">
    <table class="min-w-full border rounded-lg">
      <thead class="bg-gray-900 text-white">
        <tr>
          <th class="px-4 py-3 text-left text-sm font-medium">Order No</th>
          <th class="px-4 py-3 text-left text-sm font-medium">Customer</th>
          <th class="px-4 py-3 text-left text-sm font-medium">Status</th>
          <th class="px-4 py-3 text-left text-sm font-medium">Created</th>
          <th class="px-4 py-3 text-left text-sm font-medium">Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (orders.length === 0) { %>
          <tr>
            <td colspan="5" class="px-4 py-4 text-center text-gray-500 text-sm">
              No orders yet.
            </td>
          </tr>
        <% } else { %>
          <% orders.forEach(o => { %>
            <tr class="border-b hover:bg-gray-50">
              <td class="px-4 py-3 font-medium">#<%= o.id %></td>
              <td class="px-4 py-3"><%= o.Customer ? o.Customer.name : "-" %></td>
              <td class="px-4 py-3">
              <% let statusColor = {
                  Pending: "bg-yellow-100 text-yellow-700",
                  Stitching: "bg-blue-100 text-blue-700",
                  Done: "bg-green-100 text-green-700",
                  Collected: "bg-purple-100 text-purple-700",
                  Cancelled: "bg-red-100 text-red-700"
              }[o.status] || "bg-gray-100 text-gray-600"; %>

              <span class="px-2 py-1 rounded-md text-xs font-semibold <%= statusColor %>">
                <%= o.status %>
              </span>
            </td>
              <td class="px-4 py-3 text-sm text-gray-600"><%= o.createdAt.toLocaleString() %></td>
              <td class="px-4 py-3">
                <a href="/orders/<%= o.id %>" class="text-indigo-600 hover:underline">View</a>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include("../partials/adminLayoutEnd") %>
