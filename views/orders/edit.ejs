<%- include("../partials/adminLayoutStart", { pageTitle, pageSubTitle }) %>

<form
  action="/orders/<%= order.id %>/update"
  method="POST"
  class="bg-white rounded-lg shadow p-6 space-y-6"
>
  <!-- Top: Customer + Date -->
  <div class="grid md:grid-cols-2 gap-4">
    <!-- Customer Name -->
    <div>
      <label class="block text-sm font-semibold text-gray-700 mb-1">
        Name
      </label>
      <select
        name="customerId"
        class="w-full border border-gray-300 rounded-lg px-3 py-2
               focus:outline-none focus:ring-2 focus:ring-gray-800"
        required
      >
        <option value="">-- Select customer --</option>
        <% customers.forEach(c => { %>
          <option
            value="<%= c.id %>"
            <%= c.id === order.CustomerId ? "selected" : "" %>
          >
            <%= c.name %> (<%= c.phone %>)
          </option>
        <% }) %>
      </select>
      <p class="text-xs text-gray-500 mt-1">
        (Auto show if customer login)
      </p>
    </div>

    <!-- Order Date -->
    <div>
      <label class="block text-sm font-semibold text-gray-700 mb-1">
        Date
      </label>
      <input
        type="date"
        name="orderDate"
        value="<%= order.orderDate ? new Date(order.orderDate).toISOString().slice(0,10) : '' %>"
        class="w-full border border-gray-300 rounded-lg px-3 py-2
               focus:outline-none focus:ring-2 focus:ring-gray-800"
        required
      />
    </div>
  </div>

  <!-- Type / Purpose / Button Design -->
  <div class="grid md:grid-cols-3 gap-4">
    <!-- Type -->
    <div>
      <label class="block text-sm font-semibold text-gray-700 mb-1">
        Type
      </label>
      <select
        name="garmentType"
        class="w-full border border-gray-300 rounded-lg px-3 py-2
               focus:outline-none focus:ring-2 focus:ring-gray-800"
      >
        <option value="">-- Select --</option>
        <% ["Shirt", "Dress", "Skirt", "Suit"].forEach(t => { %>
          <option
            value="<%= t %>"
            <%= order.garmentType === t ? "selected" : "" %>
          ><%= t %></option>
        <% }) %>
      </select>
    </div>

    <!-- Purpose -->
    <div>
      <label class="block text-sm font-semibold text-gray-700 mb-1">
        Purpose
      </label>
      <select
        name="purpose"
        class="w-full border border-gray-300 rounded-lg px-3 py-2
               focus:outline-none focus:ring-2 focus:ring-gray-800"
      >
        <option value="">-- Select --</option>
        <% ["Party", "Business", "Casual", "Wedding", "Uniform"].forEach(p => { %>
          <option
            value="<%= p %>"
            <%= order.purpose === p ? "selected" : "" %>
          ><%= p %></option>
        <% }) %>
      </select>
    </div>

    <!-- Button Design -->
    <div>
      <label class="block text-sm font-semibold text-gray-700 mb-1">
        Button Design
      </label>
      <select
        name="buttonStyle"
        class="w-full border border-gray-300 rounded-lg px-3 py-2
               focus:outline-none focus:ring-2 focus:ring-gray-800"
      >
        <option value="">-- Select --</option>
        <% ["Standard", "Hidden placket", "Contrast buttons"].forEach(b => { %>
          <option
            value="<%= b %>"
            <%= order.buttonStyle === b ? "selected" : "" %>
          ><%= b %></option>
        <% }) %>
      </select>
    </div>
  </div>

  <!-- Measurements -->
  <div>
    <div class="flex items-center justify-between">
      <h3 class="font-semibold text-gray-800">Measurement</h3>
      <a
        href="https://www.youtube.com/results?search_query=how+to+take+body+measurements"
        target="_blank"
        class="text-sm text-blue-600 hover:underline"
      >
        How to make measurement?
      </a>
    </div>

    <p class="text-xs text-gray-500 mb-2">
      (in inches)
    </p>

    <div class="grid md:grid-cols-3 gap-4">
      <div>
        <label class="block text-sm text-gray-600 mb-1">Chest / Bust</label>
        <input
          type="number"
          step="0.1"
          name="measChest"
          value="<%= order.measChest || '' %>"
          class="w-full border border-gray-300 rounded-lg px-3 py-2
                 focus:outline-none focus:ring-2 focus:ring-gray-800"
        />
      </div>

      <div>
        <label class="block text-sm text-gray-600 mb-1">Waist</label>
        <input
          type="number"
          step="0.1"
          name="measWaist"
          value="<%= order.measWaist || '' %>"
          class="w-full border border-gray-300 rounded-lg px-3 py-2
                 focus:outline-none focus:ring-2 focus:ring-gray-800"
        />
      </div>

      <div>
        <label class="block text-sm text-gray-600 mb-1">Hip</label>
        <input
          type="number"
          step="0.1"
          name="measHip"
          value="<%= order.measHip || '' %>"
          class="w-full border border-gray-300 rounded-lg px-3 py-2
                 focus:outline-none focus:ring-2 focus:ring-gray-800"
        />
      </div>
    </div>
  </div>

  <!-- Length options -->
  <div>
    <h3 class="font-semibold text-gray-800 mb-2">Length</h3>
    <div class="flex flex-wrap gap-4 items-center">
      <% const lengthOpt = order.lengthOption || "medium"; %>

      <label class="inline-flex items-center gap-2 text-sm">
        <input
          type="radio"
          name="lengthOption"
          value="short"
          <%= lengthOpt === "short" ? "checked" : "" %>
        />
        Short
      </label>

      <label class="inline-flex items-center gap-2 text-sm">
        <input
          type="radio"
          name="lengthOption"
          value="medium"
          <%= lengthOpt === "medium" ? "checked" : "" %>
        />
        Medium
      </label>

      <label class="inline-flex items-center gap-2 text-sm">
        <input
          type="radio"
          name="lengthOption"
          value="long"
          <%= lengthOpt === "long" ? "checked" : "" %>
        />
        Long
      </label>

      <label class="inline-flex items-center gap-2 text-sm">
        <input
          type="radio"
          name="lengthOption"
          value="custom"
          <%= lengthOpt === "custom" ? "checked" : "" %>
        />
        Custom
      </label>

      <input
        type="number"
        step="0.1"
        name="customLength"
        placeholder="Custom length"
        value="<%= order.customLength || '' %>"
        class="border border-gray-300 rounded-lg px-3 py-2
               focus:outline-none focus:ring-2 focus:ring-gray-800 w-32"
      />
      <span class="text-xs text-gray-500">inches</span>
    </div>
  </div>

  <!-- Notes -->
  <div>
    <label class="block text-sm font-semibold text-gray-700 mb-1">
      Notes
    </label>
    <textarea
      name="notes"
      rows="4"
      class="w-full border border-gray-300 rounded-lg px-3 py-2
             focus:outline-none focus:ring-2 focus:ring-gray-800 resize-none"
    ><%= order.notes || "" %></textarea>
  </div>

  <!-- Actions -->
  <div class="flex flex-wrap gap-3 justify-between pt-4 border-t">
    <a
      href="/orders"
      class="px-4 py-2 border rounded-lg text-gray-700 hover:bg-gray-50"
    >
      Cancel
    </a>

    <button
      type="submit"
      class="px-6 py-2 bg-gray-900 text-white rounded-lg
             hover:bg-gray-800 font-medium"
    >
      Save Changes
    </button>
  </div>
</form>

<%- include("../partials/adminLayoutEnd") %>
