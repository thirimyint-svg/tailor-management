  <div id="booking-modal"
       class="fixed inset-0 z-[100] flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-300"
       aria-modal="true" role="dialog" aria-labelledby="modal-title">

    <!-- Backdrop -->
    <div id="modal-backdrop"
         class="absolute inset-0 bg-ink/70 backdrop-blur-sm"
         onclick="closeModal()"></div>

    <!-- Panel -->
    <div id="modal-panel"
         class="relative bg-white w-full max-w-lg max-h-[90vh] overflow-y-auto shadow-2xl translate-y-4 transition-transform duration-300 flex flex-col">

      <!-- Header -->
      <div class="flex items-center justify-between px-7 py-5 border-b border-parchment-dark sticky top-0 bg-white z-10">
        <div>
          <p class="text-gold text-[10px] tracking-widest uppercase mb-0.5">Milano Tailor</p>
          <h2 id="modal-title" class="font-serif text-2xl font-medium text-ink">Book a Consultation</h2>
        </div>
        <button onclick="closeModal()"
                class="w-8 h-8 flex items-center justify-center text-stone hover:text-ink transition-colors"
                aria-label="Close modal">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <!-- Form body -->
      <form method="POST" action="/appointments/create" class="px-7 py-6 space-y-5">

        <!-- Customer name -->
        <div>
          <label class="block text-xs tracking-widest uppercase text-stone font-medium mb-2">
            Customer Name <span class="text-gold">*</span>
          </label>
          <input
            name="customerName"
            placeholder="Enter Your Name"
            required
            class="w-full border border-parchment-dark bg-parchment/30 px-4 py-2.5 text-sm text-ink placeholder-stone focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-colors"
          />
        </div>

        <!-- Date & time -->
        <div>
          <label class="block text-xs tracking-widest uppercase text-stone font-medium mb-2">
            Appointment Date & Time <span class="text-gold">*</span>
          </label>
          <input type="datetime-local" name="appointmentAt" required
                 class="w-full border border-parchment-dark bg-parchment/30 px-4 py-2.5 text-sm text-ink focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-colors" />
        </div>

        <!-- Email + WhatsApp -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs tracking-widest uppercase text-stone font-medium mb-2">Email</label>
            <input name="email" type="email" placeholder="you@email.com"
                   class="w-full border border-parchment-dark bg-parchment/30 px-4 py-2.5 text-sm text-ink placeholder-stone focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-colors" />
          </div>
          <div>
            <label class="block text-xs tracking-widest uppercase text-stone font-medium mb-2">WhatsApp</label>
            <input name="whatsapp" placeholder="+66 80 000 0000"
                   class="w-full border border-parchment-dark bg-parchment/30 px-4 py-2.5 text-sm text-ink placeholder-stone focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-colors" />
          </div>
        </div>

        <!-- Hotel pickup -->
        <div>
          <label class="block text-xs tracking-widest uppercase text-stone font-medium mb-3">Hotel Pickup?</label>
          <div class="flex items-center gap-8">
            <label class="flex items-center gap-2.5 cursor-pointer group">
              <input type="radio" name="hotelPickup" value="no" checked
                     class="accent-gold w-4 h-4"
                     onchange="toggleHotel(false)" />
              <span class="text-sm text-ink group-hover:text-gold transition-colors">No</span>
            </label>
            <label class="flex items-center gap-2.5 cursor-pointer group">
              <input type="radio" name="hotelPickup" value="yes"
                     class="accent-gold w-4 h-4"
                     onchange="toggleHotel(true)" />
              <span class="text-sm text-ink group-hover:text-gold transition-colors">Yes</span>
            </label>
          </div>
        </div>

        <!-- Hotel detail fields -->
        <div id="hotelBox" class="hidden space-y-4 border-l-2 border-gold pl-5 bg-parchment/20 py-4 pr-4">
          <div>
            <label class="block text-xs tracking-widest uppercase text-stone font-medium mb-2">Hotel Name</label>
            <input name="hotelName"
                   class="w-full border border-parchment-dark bg-white px-4 py-2.5 text-sm text-ink focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-colors" />
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs tracking-widest uppercase text-stone font-medium mb-2">Room No.</label>
              <input name="roomNo"
                     class="w-full border border-parchment-dark bg-white px-4 py-2.5 text-sm text-ink focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-colors" />
            </div>
            <div>
              <label class="block text-xs tracking-widest uppercase text-stone font-medium mb-2">Hotel Address</label>
              <input name="hotelAddress"
                     class="w-full border border-parchment-dark bg-white px-4 py-2.5 text-sm text-ink focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-colors" />
            </div>
          </div>
        </div>

        <!-- Reminder -->
        <div>
          <label class="block text-xs tracking-widest uppercase text-stone font-medium mb-2">Notify Before</label>
          <select name="remindBeforeMinutes"
                  class="w-full border border-parchment-dark bg-parchment/30 px-4 py-2.5 text-sm text-ink focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-colors appearance-none cursor-pointer">
            <option value="60">1 hour before</option>
            <option value="30">30 minutes before</option>
            <option value="15">15 minutes before</option>
            <option value="0">No reminder</option>
          </select>
          <p class="text-xs text-stone mt-1.5">WhatsApp & email reminders can be configured in settings.</p>
        </div>

        <!-- Notes -->
        <div>
          <label class="block text-xs tracking-widest uppercase text-stone font-medium mb-2">Notes</label>
          <textarea name="notes" rows="3" placeholder="Garment type, style preferences, occasion…"
                    class="w-full border border-parchment-dark bg-parchment/30 px-4 py-2.5 text-sm text-ink placeholder-stone resize-none focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-colors"></textarea>
        </div>

        <!-- Submit -->
        <button type="submit"
                class="w-full bg-gold text-white text-xs tracking-widest uppercase py-3.5 hover:bg-gold-dark transition-colors duration-300 flex items-center justify-center gap-2 mt-2">
          Confirm Appointment
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </button>

      </form>
    </div>
  </div>
  
