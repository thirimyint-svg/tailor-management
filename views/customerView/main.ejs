  <!-- ─── SCRIPTS ───────────────────────────────────────────────── -->
  <script>
    // ── Booking Modal ──────────────────────────────────────────────────────
    const modal = document.getElementById('booking-modal');
    const panel = document.getElementById('modal-panel');

    function openModal() {
      modal.classList.remove('opacity-0', 'pointer-events-none');
      panel.classList.remove('translate-y-4');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.add('opacity-0', 'pointer-events-none');
      panel.classList.add('translate-y-4');
      document.body.style.overflow = '';
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });

    document.querySelectorAll('[data-book]').forEach(btn => {
      btn.addEventListener('click', (e) => { e.preventDefault(); openModal(); });
    });

    // ── Hotel pickup toggle ────────────────────────────────────────
    function toggleHotel(show) {
      const box = document.getElementById('hotelBox');
      box.classList.toggle('hidden', !show);
    }

    //logout function
    function logout() {
      fetch('/user/logout', { method: 'POST' })
        .then(() => window.location.reload())
        .catch(err => console.error('Logout failed:', err));
    }

    // ── Login modal ────────────────────────────────────────────────
const loginModal = document.getElementById('login-modal');
const loginPanel = document.getElementById('login-panel');

function openLoginModal() {
  loginModal.classList.remove('opacity-0', 'pointer-events-none');
  loginPanel.classList.remove('translate-y-4');
  document.body.style.overflow = 'hidden';
}

function closeLoginModal() {
  loginModal.classList.add('opacity-0', 'pointer-events-none');
  loginPanel.classList.add('translate-y-4');
  document.body.style.overflow = '';
}

document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') { closeLoginModal(); }
});

document.querySelectorAll('[data-login]').forEach(btn => {
  btn.addEventListener('click', (e) => { e.preventDefault(); openLoginModal(); });
});

document.querySelectorAll('[data-logout]').forEach(btn => {
  btn.addEventListener('click', (e) => { e.preventDefault(); logout(); });
});

    // ── Register modal ────────────────────────────────────────────────
const registerModal = document.getElementById('register-modal');
const registerPanel = document.getElementById('register-panel');

function openRegisterModal() {
  event.preventDefault();
  closeLoginModal(); // Ensure login modal is closed if open
  registerModal.classList.remove('opacity-0', 'pointer-events-none');
  registerPanel.classList.remove('translate-y-4');
  document.body.style.overflow = 'hidden';
}

function closeRegisterModal() {
  registerModal.classList.add('opacity-0', 'pointer-events-none');
  registerPanel.classList.add('translate-y-4');
  document.body.style.overflow = '';
}

document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') { closeRegisterModal(); }
});

document.querySelectorAll('[data-register]').forEach(btn => {
  btn.addEventListener('click', (e) => { e.preventDefault(); openRegisterModal(); });
});

    // ── Mobile nav toggle
    const hamburger = document.getElementById('hamburger');
    const mobileMenu = document.getElementById('mobile-menu');
    const bar1 = document.getElementById('bar1');
    const bar2 = document.getElementById('bar2');
    const bar3 = document.getElementById('bar3');
    let menuOpen = false;

    hamburger.addEventListener('click', () => {
      menuOpen = !menuOpen;
      if (menuOpen) {
        mobileMenu.classList.add('open');
        bar1.style.transform = 'translateY(6px) rotate(45deg)';
        bar2.style.opacity   = '0';
        bar3.style.transform = 'translateY(-6px) rotate(-45deg)';
        bar3.style.width     = '24px';
      } else {
        closeMobileMenu();
      }
    });

    function closeMobileMenu() {
      menuOpen = false;
      mobileMenu.classList.remove('open');
      bar1.style.transform = '';
      bar2.style.opacity   = '1';
      bar3.style.transform = '';
      bar3.style.width     = '16px';
    }

    // Close mobile menu on outside click
    document.addEventListener('click', (e) => {
      if (!hamburger.contains(e.target) && !mobileMenu.contains(e.target)) {
        closeMobileMenu();
      }
    });
  </script>

</body>
</html>
