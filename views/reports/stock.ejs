<%- include("../partials/adminLayoutStart", {
  pageTitle,
  pageSubTitle
}) %>

<div class="space-y-6">

  <!-- Summary -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-4">

    <div class="bg-white rounded-lg shadow p-4">
      <div class="text-xs text-gray-500 uppercase">Fabric Items</div>
      <div class="text-2xl font-bold mt-1"><%= totalFabricItems %></div>
    </div>

    <div class="bg-white rounded-lg shadow p-4">
      <div class="text-xs text-gray-500 uppercase">Total Fabric Qty</div>
      <div class="text-2xl font-bold mt-1"><%= totalFabricQty %></div>
    </div>

    <div class="bg-white rounded-lg shadow p-4">
      <div class="text-xs text-gray-500 uppercase">Accessory Items</div>
      <div class="text-2xl font-bold mt-1"><%= totalAccessoryItems %></div>
    </div>

    <div class="bg-white rounded-lg shadow p-4">
      <div class="text-xs text-gray-500 uppercase">Total Accessory Qty</div>
      <div class="text-2xl font-bold mt-1"><%= totalAccessoryQty %></div>
    </div>

  </div>

  <!-- Tables -->
  <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">

    <!-- Fabrics -->
    <div class="bg-white rounded-lg shadow p-4 overflow-x-auto">
      <h2 class="font-semibold text-gray-800 mb-3">Fabrics Stock</h2>

      <% if (!fabrics.length) { %>
        <div class="text-sm text-gray-500 py-3">
          No fabrics found.
        </div>
      <% } else { %>
        <table class="min-w-full text-sm">
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="text-left px-3 py-2">Title</th>
              <th class="text-left px-3 py-2">Code</th>
              <th class="text-left px-3 py-2">Color</th>
              <th class="text-left px-3 py-2">Stock</th>
            </tr>
          </thead>
          <tbody>
            <% fabrics.forEach(f => { %>
              <tr class="border-b last:border-0">
                <td class="px-3 py-2"><%= f.title %></td>
                <td class="px-3 py-2"><%= f.code %></td>
                <td class="px-3 py-2"><%= f.color || '' %></td>
                <td class="px-3 py-2">
                  <% if (Number(f.stockQty || 0) <= 5) { %>
                    <span class="px-2 py-1 rounded text-xs bg-red-100 text-red-700">
                      <%= f.stockQty %> (Low)
                    </span>
                  <% } else { %>
                    <span class="px-2 py-1 rounded text-xs bg-green-100 text-green-700">
                      <%= f.stockQty %>
                    </span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>

    <!-- Accessories -->
    <div class="bg-white rounded-lg shadow p-4 overflow-x-auto">
      <h2 class="font-semibold text-gray-800 mb-3">Accessories Stock</h2>

      <% if (!accessories.length) { %>
        <div class="text-sm text-gray-500 py-3">
          No accessories found.
        </div>
      <% } else { %>
        <table class="min-w-full text-sm">
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="text-left px-3 py-2">Name</th>
              <th class="text-left px-3 py-2">Type</th>
              <th class="text-left px-3 py-2">Stock</th>
            </tr>
          </thead>
          <tbody>
            <% accessories.forEach(a => { %>
              <tr class="border-b last:border-0">
                <td class="px-3 py-2"><%= a.name %></td>
                <td class="px-3 py-2"><%= a.type || '' %></td>
                <td class="px-3 py-2">
                  <% if (Number(a.stockQty || 0) <= 5) { %>
                    <span class="px-2 py-1 rounded text-xs bg-red-100 text-red-700">
                      <%= a.stockQty %> (Low)
                    </span>
                  <% } else { %>
                    <span class="px-2 py-1 rounded text-xs bg-green-100 text-green-700">
                      <%= a.stockQty %>
                    </span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>

  </div>

</div>

<%- include("../partials/adminLayoutEnd") %>
