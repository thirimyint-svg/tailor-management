<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= pageTitle || "Orders" %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            gold:    { DEFAULT: '#8B6A3E', light: '#B8956A', dark:  '#6B5030' },
            ink:     { DEFAULT: '#1A1208', mid: '#2E2212',   light: '#3D3020' },
            parchment: { DEFAULT: '#F5EFE6', mid: '#E8DDD0', dark: '#D4C5B0' },
            stone:   '#A89880',
          },
          fontFamily: {
            serif:  ['Cormorant Garamond', 'Georgia', 'serif'],
            sans:   ['Jost', 'sans-serif'],
          },
          letterSpacing: {
            widest2: '0.18em',
          },
        }
      }
    }
  </script>
  <style>
    .status-pending { color: #B8956A; background-color: #F5EFE6; }
    .status-confirmed { color: #4B7C3C; background-color: #E8F5E1; }
    .status-completed { color: #1A6B4B; background-color: #D4F0E8; }
    .status-cancelled { color: #8B4545; background-color: #F5E8E5; }
  </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4 sm:p-8">

    <!-- Main Container (Replaces the Modal Panel) -->
    <div class="bg-white w-full max-w-lg shadow-2xl flex flex-col border border-parchment-dark">

        <!-- Header -->
        <div class="px-7 py-8 border-b border-parchment-dark text-center">
            <p class="text-gold text-[11px] tracking-[0.2em] uppercase mb-2">Milano Tailor</p>
            <h1 class="font-serif text-3xl font-medium text-ink">Book a Consultation</h1>
            <p class="text-stone text-sm mt-2 italic">Exquisite tailoring, personalized for you.</p>
        </div>

        <!-- Form body -->
        <form method="POST" action="/appointments/create" class="px-7 py-8 space-y-6">

            <!-- Customer name -->
            <div>
                <label class="block text-xs tracking-widest uppercase text-stone font-medium mb-2">
                    Customer Name <span class="text-gold">*</span>
                </label>
                <input
                    name="customerName"
                    placeholder="Enter Your Name"
                    value="<%= user ? user.name : '' %>"
                    readonly
                    required
                    class="w-full border border-parchment-dark bg-parchment/30 px-4 py-3 text-sm text-ink placeholder-stone focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-colors"
                />
            </div>

            <!-- Date & time -->
            <div>
                <label class="block text-xs tracking-widest uppercase text-stone font-medium mb-2">
                    Appointment Date & Time <span class="text-gold">*</span>
                </label>
                <input type="datetime-local" name="appointmentAt" required
                       class="w-full border border-parchment-dark bg-parchment/30 px-4 py-3 text-sm text-ink focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-colors" />
            </div>

            <!-- Email + WhatsApp -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                    <label class="block text-xs tracking-widest uppercase text-stone font-medium mb-2">Email</label>
                    <input name="email" type="email" placeholder="you@email.com"
                           class="w-full border border-parchment-dark bg-parchment/30 px-4 py-3 text-sm text-ink placeholder-stone focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-colors" />
                </div>
                <div>
                    <label class="block text-xs tracking-widest uppercase text-stone font-medium mb-2">WhatsApp</label>
                    <input name="whatsapp" placeholder="+66 80 000 0000"
                           class="w-full border border-parchment-dark bg-parchment/30 px-4 py-3 text-sm text-ink placeholder-stone focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-colors" />
                </div>
            </div>

            <!-- Hotel pickup -->
            <div>
                <label class="block text-xs tracking-widest uppercase text-stone font-medium mb-3">Hotel Pickup?</label>
                <div class="flex items-center gap-8">
                    <label class="flex items-center gap-2.5 cursor-pointer group">
                        <input type="radio" name="hotelPickup" value="no" checked
                               class="accent-gold w-4 h-4"
                               onchange="toggleHotel(false)" />
                        <span class="text-sm text-ink group-hover:text-gold transition-colors">No, I will visit the showroom</span>
                    </label>
                    <label class="flex items-center gap-2.5 cursor-pointer group">
                        <input type="radio" name="hotelPickup" value="yes"
                               class="accent-gold w-4 h-4"
                               onchange="toggleHotel(true)" />
                        <span class="text-sm text-ink group-hover:text-gold transition-colors">Yes, please pick me up</span>
                    </label>
                </div>
            </div>

            <!-- Hotel detail fields -->
            <div id="hotelBox" class="hidden space-y-4 border-l-2 border-gold pl-5 bg-parchment/20 py-5 pr-4">
                <div>
                    <label class="block text-xs tracking-widest uppercase text-stone font-medium mb-2">Hotel Name</label>
                    <input name="hotelName"
                           class="w-full border border-parchment-dark bg-white px-4 py-2.5 text-sm text-ink focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-colors" />
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs tracking-widest uppercase text-stone font-medium mb-2">Room No.</label>
                        <input name="roomNo"
                               class="w-full border border-parchment-dark bg-white px-4 py-2.5 text-sm text-ink focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-colors" />
                    </div>
                    <div>
                        <label class="block text-xs tracking-widest uppercase text-stone font-medium mb-2">Hotel Address</label>
                        <input name="hotelAddress"
                               class="w-full border border-parchment-dark bg-white px-4 py-2.5 text-sm text-ink focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-colors" />
                    </div>
                </div>
            </div>

            <!-- Reminder -->
            <div>
                <label class="block text-xs tracking-widest uppercase text-stone font-medium mb-2">Notify Before</label>
                <div class="relative">
                    <select name="remindBeforeMinutes"
                            class="w-full border border-parchment-dark bg-parchment/30 px-4 py-3 text-sm text-ink focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-colors appearance-none cursor-pointer">
                        <option value="60">1 hour before</option>
                        <option value="30">30 minutes before</option>
                        <option value="15">15 minutes before</option>
                        <option value="0">No reminder</option>
                    </select>
                    <!-- Custom Arrow for Select -->
                    <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-stone">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </div>
                </div>
            </div>

            <!-- Notes -->
            <div>
                <label class="block text-xs tracking-widest uppercase text-stone font-medium mb-2">Special Requirements / Notes</label>
                <textarea name="notes" rows="4" placeholder="Garment type, style preferences, occasion…"
                          class="w-full border border-parchment-dark bg-parchment/30 px-4 py-3 text-sm text-ink placeholder-stone resize-none focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-colors"></textarea>
            </div>

            <!-- Submit -->
            <div class="pt-4">
                <button type="submit"
                        class="w-full bg-gold text-white text-xs tracking-[0.2em] uppercase py-4 hover:bg-gold-dark transition-colors duration-300 flex items-center justify-center gap-3 shadow-lg shadow-gold/20">
                    Confirm Appointment
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                    </svg>
                </button>
                <p class="text-[10px] text-stone text-center mt-4 uppercase tracking-widest">A confirmation will be sent to your email.</p>
            </div>

        </form>
    </div>

</body>
</html>