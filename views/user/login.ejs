<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= pageTitle || "Customer Login" %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-gray-100">

  <div class="min-h-screen flex">

    <!-- Left sidebar (simple customer branding) -->
    <aside class="hidden md:flex md:flex-col w-64 bg-gray-900 text-white p-6">
      <div class="text-xl font-bold mb-2">Customer</div>
      <div class="text-sm text-gray-400 mb-6">Tailor Management System</div>

      <nav class="space-y-2 text-sm">
        <div class="font-semibold text-gray-400 mb-2">MENU</div>
        <div class="px-3 py-2 rounded bg-gray-800">Login</div>
        <div class="px-3 py-2 rounded text-gray-500">Dashboard (after login)</div>
        <div class="px-3 py-2 rounded text-gray-500">Orders</div>
        <div class="px-3 py-2 rounded text-gray-500">Appointments</div>
      </nav>
    </aside>

    <!-- Main panel -->
    <main class="flex-1 px-4 py-6 md:px-10 md:py-10">

      <% if (error && error.length) { %>
        <div class="mb-4 p-3 rounded bg-red-100 text-red-800 border border-red-200">
          <%= error[0] %>
        </div>
      <% } %>

      <% if (success && success.length) { %>
        <div class="mb-4 p-3 rounded bg-green-100 text-green-800 border border-green-200">
          <%= success[0] %>
        </div>
      <% } %>

      <h1 class="text-2xl font-bold mb-1">Customer Login</h1>
      <p class="text-sm text-gray-500 mb-6">Login to your account</p>

      <div class="bg-white rounded-xl shadow p-6 max-w-3xl">
        <form action="/user/login" method="POST" class="space-y-5">

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">
              Email
            </label>
            <input
              type="email"
              name="email"
              required
              class="w-full border border-gray-300 rounded-lg px-3 py-2
                     focus:outline-none focus:ring-2 focus:ring-gray-900"
              placeholder="you@email.com"
            />
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">
              Password
            </label>
            <input
              type="password"
              name="password"
              required
              class="w-full border border-gray-300 rounded-lg px-3 py-2
                     focus:outline-none focus:ring-2 focus:ring-gray-900"
              placeholder="••••••••"
            />
          </div>

          <button
            type="submit"
            class="w-full bg-gray-900 text-white py-2 rounded-lg
                   hover:bg-gray-800 transition font-medium"
          >
            Login
          </button>

          <p class="mt-2 text-xs text-gray-500">
            Customer accounts are created by Admin (for now).
          </p>
        </form>
      </div>
    </main>
  </div>

</body>
</html>
