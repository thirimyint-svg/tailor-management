<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= pageTitle || "Profile" %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            gold:    { DEFAULT: '#8B6A3E', light: '#B8956A', dark:  '#6B5030' },
            ink:     { DEFAULT: '#1A1208', mid: '#2E2212',   light: '#3D3020' },
            parchment: { DEFAULT: '#F5EFE6', mid: '#E8DDD0', dark: '#D4C5B0' },
            stone:   '#A89880',
          },
          fontFamily: {
            serif:  ['Cormorant Garamond', 'Georgia', 'serif'],
            sans:   ['Jost', 'sans-serif'],
          },
          letterSpacing: {
            widest2: '0.18em',
          },
        }
      }
    }
  </script>
</head>
<body class="bg-parchment font-sans text-ink">

  <!-- Navigation -->
  <nav class="bg-ink text-parchment p-4">
    <div class="max-w-6xl mx-auto flex justify-between items-center">
      <a href="/" class="font-serif text-xl tracking-widest">MILANO <span class="text-gold">TAILOR</span></a>
      <div class="space-x-4">
        <a href="/user/dashboard" class="hover:text-gold">Dashboard</a>
        <a href="/user/orders" class="hover:text-gold">Orders</a>
        <a href="/user/profile" class="text-gold">Profile</a>
        <a href="/user/logout" class="hover:text-gold">Logout</a>
      </div>
    </div>
  </nav>

  <div class="max-w-4xl mx-auto p-6">
    <h1 class="font-serif text-4xl text-ink mb-2"><%= pageTitle %></h1>
    <p class="text-stone mb-8"><%= pageSubTitle %></p>

    <%- include('../partials/flash') %>

    <div class="bg-white p-8 rounded shadow">
      <h2 class="font-serif text-2xl text-ink mb-6">Account Information</h2>

      <form method="POST" action="/user/profile" class="space-y-6">
        <div>
          <label class="block text-sm font-medium text-stone mb-2">Full Name</label>
          <input type="text" name="name" value="<%= user.name %>" required
                 class="w-full border border-parchment-dark bg-parchment/30 px-4 py-2 focus:outline-none focus:border-gold">
        </div>

        <div>
          <label class="block text-sm font-medium text-stone mb-2">Email</label>
          <input type="email" name="email" value="<%= user.email %>" readonly
                 class="w-full border border-parchment-dark bg-gray-100 px-4 py-2 cursor-not-allowed">
          <p class="text-xs text-stone mt-1">Email cannot be changed. Contact support if needed.</p>
        </div>

        <div>
          <label class="block text-sm font-medium text-stone mb-2">Phone</label>
          <input type="tel" name="phone" value="<%= user.phone || '' %>"
                 class="w-full border border-parchment-dark bg-parchment/30 px-4 py-2 focus:outline-none focus:border-gold">
        </div>

        <div>
          <label class="block text-sm font-medium text-stone mb-2">Address</label>
          <textarea name="address" rows="3"
                    class="w-full border border-parchment-dark bg-parchment/30 px-4 py-2 focus:outline-none focus:border-gold"><%= user.address || '' %></textarea>
        </div>

        <button type="submit" class="bg-gold text-white px-6 py-2 hover:bg-gold-dark transition-colors">
          Update Profile
        </button>
      </form>

      <hr class="my-8">

      <h3 class="font-serif text-xl text-ink mb-4">Change Password</h3>
      <form method="POST" action="/user/change-password" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-stone mb-2">Current Password</label>
          <input type="password" name="currentPassword" required
                 class="w-full border border-parchment-dark bg-parchment/30 px-4 py-2 focus:outline-none focus:border-gold">
        </div>

        <div>
          <label class="block text-sm font-medium text-stone mb-2">New Password</label>
          <input type="password" name="newPassword" required
                 class="w-full border border-parchment-dark bg-parchment/30 px-4 py-2 focus:outline-none focus:border-gold">
        </div>

        <div>
          <label class="block text-sm font-medium text-stone mb-2">Confirm New Password</label>
          <input type="password" name="confirmPassword" required
                 class="w-full border border-parchment-dark bg-parchment/30 px-4 py-2 focus:outline-none focus:border-gold">
        </div>

        <button type="submit" class="bg-gold text-white px-6 py-2 hover:bg-gold-dark transition-colors">
          Change Password
        </button>
      </form>
    </div>
  </div>

</body>
</html>