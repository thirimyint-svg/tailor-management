<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= pageTitle || "Customer Dashboard" %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-gray-100">

<div class="min-h-screen flex">

  <!-- Sidebar -->
  <aside class="w-64 bg-gray-900 text-white p-6 hidden md:block">
    <div class="text-xl font-bold mb-1">Customer</div>
    <div class="text-xs text-gray-400 mb-6"><%= customer.email %></div>

    <nav class="space-y-1 text-sm">
      <a href="/user/dashboard" class="block px-3 py-2 rounded bg-gray-800">
        🏠 Dashboard
      </a>
      <a href="#" class="block px-3 py-2 rounded hover:bg-gray-800">
        👤 Profile
      </a>
      <a href="#" class="block px-3 py-2 rounded hover:bg-gray-800">
        📦 Orders
      </a>
      <a href="#" class="block px-3 py-2 rounded hover:bg-gray-800">
        📅 Appointments
      </a>
      <a href="#" class="block px-3 py-2 rounded hover:bg-gray-800">
        🧵 Fabrics
      </a>

      <form action="/user/logout" method="POST" class="mt-4">
        <button class="w-full px-3 py-2 rounded bg-red-600 hover:bg-red-700 text-left">
          🚪 Logout
        </button>
      </form>
    </nav>
  </aside>

  <!-- Main -->
  <main class="flex-1 px-4 py-6 md:px-10 md:py-10">
    <% if (success && success.length) { %>
      <div class="mb-4 p-3 bg-green-100 text-green-800 rounded">
        <%= success[0] %>
      </div>
    <% } %>

    <h1 class="text-2xl font-bold mb-1"><%= pageTitle %></h1>
    <p class="text-sm text-gray-500 mb-6"><%= pageSubTitle %></p>

    <div class="grid gap-4 md:grid-cols-3">
      <div class="bg-white rounded-lg shadow p-4">
        <p class="text-gray-500 text-xs uppercase">Name</p>
        <p class="text-lg font-semibold"><%= customer.name %></p>
      </div>

      <div class="bg-white rounded-lg shadow p-4">
        <p class="text-gray-500 text-xs uppercase">Email</p>
        <p class="text-lg"><%= customer.email %></p>
      </div>

      <div class="bg-white rounded-lg shadow p-4">
        <p class="text-gray-500 text-xs uppercase">Customer ID</p>
        <p class="text-lg"><%= customer.id %></p>
      </div>
    </div>
  </main>
</div>

</body>
</html>
