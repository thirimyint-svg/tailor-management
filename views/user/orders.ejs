<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= pageTitle || "Orders" %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            gold:    { DEFAULT: '#8B6A3E', light: '#B8956A', dark:  '#6B5030' },
            ink:     { DEFAULT: '#1A1208', mid: '#2E2212',   light: '#3D3020' },
            parchment: { DEFAULT: '#F5EFE6', mid: '#E8DDD0', dark: '#D4C5B0' },
            stone:   '#A89880',
          },
          fontFamily: {
            serif:  ['Cormorant Garamond', 'Georgia', 'serif'],
            sans:   ['Jost', 'sans-serif'],
          },
          letterSpacing: {
            widest2: '0.18em',
          },
        }
      }
    }
  </script>
  <style>
    .status-pending { color: #B8956A; background-color: #F5EFE6; }
    .status-confirmed { color: #4B7C3C; background-color: #E8F5E1; }
    .status-completed { color: #1A6B4B; background-color: #D4F0E8; }
    .status-cancelled { color: #8B4545; background-color: #F5E8E5; }
  </style>
</head>
<body class="bg-parchment font-sans text-ink">

  <!-- Navigation -->
  <nav class="bg-ink text-parchment p-4">
    <div class="max-w-6xl mx-auto flex justify-between items-center">
      <a href="/" class="font-serif text-xl tracking-widest">MILANO <span class="text-gold">TAILOR</span></a>
      <div class="space-x-4 text-sm">
        <a href="/user/dashboard" class="hover:text-gold">Dashboard</a>
        <a href="/user/orders" class="text-gold">Orders</a>
        <a href="/user/profile" class="hover:text-gold">Profile</a>
        <a href="/user/logout" class="hover:text-gold">Logout</a>
      </div>
    </div>
  </nav>

  <div class="max-w-6xl mx-auto p-6">
    <div class="mb-8">
      <h1 class="font-serif text-4xl text-ink mb-2"><%= pageTitle %></h1>
      <p class="text-stone"><%= pageSubTitle %></p>
    </div>

    <%- include('../partials/flash') %>

    <% if (orders && orders.length > 0) { %>
      <div class="space-y-4">
        <% orders.forEach((order, index) => { %>
          <div class="bg-white border border-parchment-dark rounded-lg overflow-hidden hover:shadow-md transition-shadow">
            <!-- Order Header -->
            <div class="p-6 border-b border-parchment-dark flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
              <div>
                <div class="text-sm text-stone mb-1">Order #<strong><%= order.id %></strong></div>
                <div class="text-xs text-stone">
                  Placed on <strong><%= new Date(order.orderDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></strong>
                </div>
              </div>
              <div class="flex flex-col sm:flex-row gap-4 items-start sm:items-center w-full sm:w-auto">
                <div class="text-right">
                  <div class="text-2xl font-serif text-gold font-medium"><%= order.totalAmount.toFixed(2) %> THB</div>
                </div>
                <span class="px-3 py-1.5 text-xs tracking-widest uppercase font-medium rounded status-<%= order.status.toLowerCase() %>">
                  <%= order.status %>
                </span>
              </div>
            </div>

            <!-- Order Items -->
            <div class="px-6 py-4 bg-parchment/20">
              <h3 class="font-serif text-sm font-medium text-ink mb-3">Items</h3>
              <div class="space-y-2">
                <% if (order.OrderItems && order.OrderItems.length > 0) { %>
                  <% order.OrderItems.forEach((item) => { %>
                    <div class="flex justify-between items-center text-sm">
                      <div>
                        <span class="text-ink font-medium"><%= item.itemName %></span>
                        <span class="text-stone ml-2">x<%= item.qty %></span>
                      </div>
                      <span class="text-ink font-medium"><%= (item.price * item.qty).toFixed(2) %> THB</span>
                    </div>
                  <% }); %>
                <% } else { %>
                  <p class="text-sm text-stone">No items in this order.</p>
                <% } %>
              </div>
            </div>

            <!-- Order Notes -->
            <% if (order.notes) { %>
              <div class="px-6 py-4 border-t border-parchment-dark">
                <h3 class="font-serif text-sm font-medium text-ink mb-2">Notes</h3>
                <p class="text-sm text-stone"><%= order.notes %></p>
              </div>
            <% } %>

            <!-- Order Footer -->
            <div class="px-6 py-4 bg-parchment/10 flex gap-3">
              <a href="/user/orders/<%= order.id %>" class="px-4 py-2 text-xs tracking-widest uppercase border border-gold text-gold hover:bg-gold hover:text-white transition-colors">
                View Details
              </a>
              <% if (order.status.toLowerCase() === 'pending') { %>
                <button class="cancel-order-btn px-4 py-2 text-xs tracking-widest uppercase border border-stone text-stone hover:bg-stone hover:text-white transition-colors" data-order-id="<%= order.id %>">
                  Cancel Order
                </button>
              <% } %>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="bg-white border border-parchment-dark rounded-lg p-12 text-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 mx-auto text-stone/30 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
        <h3 class="font-serif text-xl text-ink mb-2">No Orders Yet</h3>
        <p class="text-stone text-sm mb-6">You haven't placed any orders yet. Ready to create your first bespoke garment?</p>
        <a href="/book-appointment" class="inline-block px-6 py-2.5 bg-gold text-white text-xs tracking-widest uppercase hover:bg-gold-dark transition-colors">
          Book a Consultation
        </a>
      </div>
    <% } %>
  </div>

  <script>
    document.querySelectorAll('.cancel-order-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const orderId = this.getAttribute('data-order-id');
        if (confirm('Are you sure you want to cancel this order?')) {
          fetch(`/user/orders/${orderId}/cancel`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          })
          .then(res => res.json())
          .then(data => {
            if (data.success) {
              window.location.reload();
            } else {
              alert(data.message || 'Failed to cancel order');
            }
          })
          .catch(err => console.error('Error:', err));
        }
      });
    });
  </script>

</body>
</html>