<form action="/user/login" method="POST" class="space-y-4">
  <div>
    <label>Email</label>
    <input
      type="email"
      name="email"         <!-- 👈 MUST be "email" -->
      class="..."
    />
  </div>

  <div>
    <label>Password</label>
    <input
      type="password"
