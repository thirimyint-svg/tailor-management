<%- include("../partials/adminLayoutStart", { pageTitle, pageSubTitle }) %>

<div class="max-w-2xl bg-white rounded-lg shadow p-5">
  <form action="/inventory/fabrics/<%= fabric.id %>/update" method="POST" class="space-y-3">
    <div>
      <label class="text-sm text-gray-600">Title *</label>
      <input name="title" class="w-full border rounded px-3 py-2" value="<%= fabric.title %>" required>
    </div>

    <div>
      <label class="text-sm text-gray-600">Code *</label>
      <input name="code" class="w-full border rounded px-3 py-2" value="<%= fabric.code %>" required>
    </div>

    <div>
      <label class="text-sm text-gray-600">Image URL</label>
      <input name="imageUrl" class="w-full border rounded px-3 py-2" value="<%= fabric.imageUrl || '' %>">
    </div>

    <div class="grid grid-cols-2 gap-3">
      <div>
        <label class="text-sm text-gray-600">Color</label>
        <input name="color" class="w-full border rounded px-3 py-2" value="<%= fabric.color || '' %>">
      </div>
      <div>
        <label class="text-sm text-gray-600">Stock Qty</label>
        <input name="stockQty" type="number" class="w-full border rounded px-3 py-2" value="<%= fabric.stockQty %>">
      </div>
    </div>

    <div>
      <label class="text-sm text-gray-600">Notes</label>
      <textarea name="notes" class="w-full border rounded px-3 py-2" rows="4"><%= fabric.notes || '' %></textarea>
    </div>

    <div class="flex gap-2">
      <button class="bg-gray-900 text-white rounded px-5 py-2 hover:bg-gray-800">Save</button>
      <a href="/inventory/fabrics" class="border rounded px-5 py-2 hover:bg-gray-50">Back</a>
    </div>
  </form>
</div>

<%- include("../partials/adminLayoutEnd") %>
