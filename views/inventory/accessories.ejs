<%- include("../partials/adminLayoutStart", { pageTitle, pageSubTitle }) %>

<%
// Make sure we NEVER crash if q is missing
const searchTerm = (typeof q !== "undefined" && q) ? q : "";
%>

<div class="grid grid-cols-1 lg:grid-cols-4 gap-6">

  <!-- Add Accessory Form -->
  <div class="lg:col-span-1 bg-white rounded-lg shadow p-5 space-y-4">
    <h2 class="text-lg font-semibold text-gray-800">Add Accessory</h2>
    <p class="text-xs text-gray-500 mb-2">
      Add trims, buttons, lining, zips and other accessories.
    </p>

    <form action="/inventory/accessories" method="POST" class="space-y-3">
      <div>
        <label class="block text-sm font-medium text-gray-600 mb-1">
          Name *
        </label>
        <input
          name="name"
          required
          class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm
                 focus:outline-none focus:ring-2 focus:ring-gray-800"
          placeholder="Plastic Button, Lining, Zip..."
        />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-600 mb-1">
          Code
        </label>
        <input
          name="code"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm
                 focus:outline-none focus:ring-2 focus:ring-gray-800"
          placeholder="BTN-001"
        />
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1">
            Category
          </label>
          <input
            name="category"
            class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm
                   focus:outline-none focus:ring-2 focus:ring-gray-800"
            placeholder="Button / Lining / Zip"
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1">
            Stock Qty
          </label>
          <input
            type="number"
            name="stockQty"
            value="0"
            class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm
                   focus:outline-none focus:ring-2 focus:ring-gray-800"
          />
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-600 mb-1">
          Notes
        </label>
        <textarea
          name="notes"
          rows="3"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm
                 focus:outline-none focus:ring-2 focus:ring-gray-800 resize-none"
          placeholder="Any colour / size details"
        ></textarea>
      </div>

      <button
        type="submit"
        class="w-full bg-gray-900 text-white py-2 rounded-lg text-sm
               hover:bg-gray-800 transition font-medium"
      >
        Save Accessory
      </button>
    </form>
  </div>

  <!-- Accessory List -->
  <div class="lg:col-span-3 space-y-4">

    <!-- Header + Search -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
      <div>
        <h2 class="text-lg font-bold text-gray-900">Accessory List</h2>
        <p class="text-sm text-gray-500">
          Search by name, code or category.
        </p>
      </div>

      <form method="GET" class="flex gap-2">
        <input
          name="q"
          value="<%= searchTerm %>"
          class="border border-gray-300 rounded-lg px-3 py-2 text-sm
                 focus:outline-none focus:ring-2 focus:ring-gray-800"
          placeholder="Search name / code / category"
        />
        <button
          class="bg-gray-900 text-white text-sm px-4 py-2 rounded-lg
                 hover:bg-gray-800 transition"
        >
          Search
        </button>
      </form>
    </div>

    <!-- Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
      <% if (!accessories || !accessories.length) { %>
        <div class="col-span-full bg-white rounded-lg p-4 text-gray-500 text-sm">
          No accessories yet.
        </div>
      <% } %>

      <% accessories.forEach(a => { %>
        <div class="bg-white rounded-lg shadow border border-gray-100 overflow-hidden">
          <div class="p-4 space-y-1">
            <div class="flex items-center justify-between">
              <h3 class="font-semibold text-gray-900 text-sm">
                <%= a.name %>
              </h3>
              <span class="text-xs px-2 py-1 rounded-full bg-gray-100 text-gray-700">
                Stock: <%= a.stockQty || 0 %>
              </span>
            </div>

            <div class="text-xs text-gray-500">
              Code:
              <span class="font-mono"><%= a.code || "-" %></span>
            </div>

            <div class="text-xs text-gray-500">
              Category:
              <span><%= a.category || "-" %></span>
            </div>

            <% if (a.notes) { %>
              <div class="mt-2 text-xs text-gray-600 line-clamp-2">
                <%= a.notes %>
              </div>
            <% } %>
          </div>

          <div class="border-t border-gray-100 flex">
            <!-- Optional: add edit later -->
            <form
              action="/inventory/accessories/<%= a.id %>/delete"
              method="POST"
              class="flex-1"
            >
              <button
                class="w-full text-xs text-red-600 py-2 hover:bg-red-50
                       border-l border-gray-100"
                onclick="return confirm('Delete this accessory?');"
              >
                Delete
              </button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>

  </div>
</div>

<%- include("../partials/adminLayoutEnd") %>
