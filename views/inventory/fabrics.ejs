<%- include("../partials/adminLayoutStart", { pageTitle, pageSubTitle }) %>

<div class="grid grid-cols-1 lg:grid-cols-4 gap-6">

  <!-- ✅ Add Fabric (Nice compact card) -->
  <div class="lg:col-span-1">
    <form action="/inventory/fabrics/create" method="POST" enctype="multipart/form-data">
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
        <div class="mb-5">
          <h2 class="text-xl font-bold text-gray-900">Add Fabric</h2>
          <p class="text-sm text-gray-500 mt-1">Upload swatch and manage stock</p>
        </div>

        <div class="space-y-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Fabric Image</label>
            <input
              type="file"
              name="image"
              accept="image/*"
              class="w-full text-sm text-gray-600
                     file:mr-3 file:py-2 file:px-4
                     file:rounded-xl file:border-0
                     file:text-sm file:font-semibold
                     file:bg-gray-900 file:text-white
                     hover:file:bg-gray-800
                     border border-gray-200 rounded-xl bg-white
                     focus:outline-none focus:ring-4 focus:ring-gray-900/10"
            />
            <p class="text-xs text-gray-500 mt-2">PNG/JPG recommended</p>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              Title <span class="text-red-500">*</span>
            </label>
            <input
              name="title"
              placeholder="Tweed Blazer Fabric"
              required
              class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm
                     placeholder:text-gray-400
                     focus:outline-none focus:ring-4 focus:ring-gray-900/10"
            />
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              Code <span class="text-red-500">*</span>
            </label>
            <input
              name="code"
              placeholder="BTW-101"
              required
              class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm
                     placeholder:text-gray-400
                     focus:outline-none focus:ring-4 focus:ring-gray-900/10"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Color</label>
              <input
                name="color"
                placeholder="Blue"
                class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm
                       placeholder:text-gray-400
                       focus:outline-none focus:ring-4 focus:ring-gray-900/10"
              />
            </div>

            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Stock Qty</label>
              <input
                type="number"
                name="stockQty"
                value="0"
                min="0"
                class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm
                       focus:outline-none focus:ring-4 focus:ring-gray-900/10"
              />
            </div>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Notes</label>
            <textarea
              name="notes"
              rows="3"
              placeholder="Any notes..."
              class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm
                     placeholder:text-gray-400 resize-none
                     focus:outline-none focus:ring-4 focus:ring-gray-900/10"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full rounded-xl bg-gray-900 text-white py-3 text-sm font-semibold
                   hover:bg-gray-800 transition focus:outline-none focus:ring-4 focus:ring-gray-900/20"
          >
            Save Fabric
          </button>
        </div>
      </div>
    </form>
  </div>

  <!-- ✅ Gallery (Small images + clean cards) -->
  <div class="lg:col-span-3">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
      <div>
        <h2 class="text-xl font-bold text-gray-900">Fabric Gallery</h2>
        <p class="text-sm text-gray-500">Small swatches grid view</p>
      </div>

      <form method="GET" action="/inventory/fabrics" class="flex gap-2">
        <input
          name="q"
          value="<%= q || '' %>"
          placeholder="Search code/title"
          class="border border-gray-200 rounded-xl px-4 py-2 text-sm w-56
                 focus:outline-none focus:ring-4 focus:ring-gray-900/10"
        />
        <button class="bg-gray-900 text-white rounded-xl px-4 py-2 text-sm font-semibold hover:bg-gray-800">
          Search
        </button>
      </form>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 gap-4">
      <% if (!fabrics.length) { %>
        <div class="col-span-full bg-white border border-gray-100 rounded-2xl p-6 text-gray-500">
          No fabrics yet.
        </div>
      <% } %>

      <% fabrics.forEach(f => { %>
        <div class="bg-white border border-gray-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition">
          <!-- ✅ SMALL image -->
          <div class="h-32 bg-gray-100">
            <% if (f.imageUrl) { %>
              <img src="<%= f.imageUrl %>" alt="<%= f.code %>" class="w-full h-full object-cover">
            <% } else { %>
              <div class="w-full h-full flex items-center justify-center text-gray-400 text-sm">
                No Image
              </div>
            <% } %>
          </div>

          <div class="p-3">
            <div class="font-semibold text-gray-900 text-sm truncate"><%= f.title %></div>

            <div class="mt-1 flex items-center justify-between">
              <span class="text-xs text-gray-600 font-medium"><%= f.code %></span>
              <span class="text-[11px] px-2 py-1 rounded-full bg-gray-100 text-gray-700">
                Stock: <%= f.stockQty %>
              </span>
            </div>

            <div class="mt-3 grid grid-cols-2 gap-2">
              <a
                href="/inventory/fabrics/<%= f.id %>/edit"
                class="text-center text-xs font-semibold py-2 rounded-xl border border-gray-200 hover:bg-gray-50"
              >
                Edit
              </a>

              <form action="/inventory/fabrics/<%= f.id %>/delete" method="POST">
                <button
                  type="submit"
                  class="w-full text-xs font-semibold py-2 rounded-xl bg-red-600 text-white hover:bg-red-700"
                  onclick="return confirm('Delete this fabric?')"
                >
                  Delete
                </button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</div>

<%- include("../partials/adminLayoutEnd") %>
